---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import Modules from "@/components/sections/Modules.astro";
import Industries from "@/components/sections/Industries.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { content } from "@/lib/content";
---
<BaseLayout content={content} title={`Модулиуд — ${content.meta.title}`}>
  <PageHeader
    eyebrow="40+ модуль, нэг платформ" eyebrowEn="40+ modules, one platform"
    title={'Бүх <span class="grad-text">модулиуд</span>'} titleEn={'All <span class="grad-text">modules</span>'}
    sub="Бизнесийн болон салбарын модулиудаас хэрэгтэйгээ сонгоно." subEn="Choose what you need from business and industry modules."
  />
  <Modules content={content} />
  <Industries content={content} />
  <FinalCta content={content} />
</BaseLayout>
