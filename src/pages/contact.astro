---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import Demo from "@/components/sections/Demo.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { content } from "@/lib/content";
---
<BaseLayout content={content} title={`Холбоо барих — ${content.meta.title}`}>
  <PageHeader
    eyebrow="Холбоо барих" eyebrowEn="Get in touch"
    title={'Бидэнтэй <span class="grad-text">холбогдоорой</span>'} titleEn={'<span class="grad-text">Contact</span> us'}
    sub={`${content.contact.email} · ${content.contact.phone}`}
  />
  <Demo content={content} />
  <FinalCta content={content} />
</BaseLayout>
