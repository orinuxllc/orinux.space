---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import Comparison from "@/components/sections/Comparison.astro";
import Features from "@/components/sections/Features.astro";
import Results from "@/components/sections/Results.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { content } from "@/lib/content";
---
<BaseLayout content={content} title={`Бидний тухай — ${content.meta.title}`}>
  <PageHeader
    eyebrow="Бидний тухай" eyebrowEn="About us"
    title={'ERP-ийн дараа үе — <span class="grad-text">ARP</span>'} titleEn={'The next era of ERP — <span class="grad-text">ARP</span>'}
    sub="Orinux нь Монголын бизнесүүдэд зориулсан AI Agent суурьтай дараа үеийн ERP платформ." subEn="Orinux is the next-generation, AI-agent-native ERP platform built for Mongolian businesses."
  />
  <Comparison content={content} />
  <Features content={content} />
  <Results content={content} />
  <FinalCta content={content} />
</BaseLayout>
