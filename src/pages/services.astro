---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import Services from "@/components/sections/Services.astro";
import Comparison from "@/components/sections/Comparison.astro";
import Demo from "@/components/sections/Demo.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { content } from "@/lib/content";
---
<BaseLayout content={content} title={`Үйлчилгээ — ${content.meta.title}`}>
  <PageHeader
    eyebrow="Мэргэжлийн үйлчилгээ" eyebrowEn="Professional services"
    title={'AI Agent &amp; RAG <span class="grad-text">үйлчилгээ</span>'} titleEn={'AI Agent &amp; RAG <span class="grad-text">services</span>'}
    sub="Танай байгууллагыг AI-аар автоматжуулах бүрэн шийдэл." subEn="A complete solution to automate your organization with AI."
  />
  <Services content={content} />
  <Comparison content={content} />
  <Demo content={content} />
  <FinalCta content={content} />
</BaseLayout>
