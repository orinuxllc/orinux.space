---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { content } from "@/lib/content";
---
<BaseLayout content={content} title="404 — Хуудас олдсонгүй">
  <section class="final" style="min-height:80vh;display:flex;align-items:center;">
    <div class="wrap">
      <div class="final-card reveal in" style="text-align:center;">
        <div class="grad-text" style="font-family:var(--display);font-size:clamp(72px,16vw,140px);line-height:1;">404</div>
        <h2 style="margin-top:12px;">Хуудас олдсонгүй</h2>
        <p>Таны хайсан хуудас байхгүй эсвэл зөөгдсөн байна.</p>
        <div class="final-cta">
          <a class="btn btn-primary magnetic" href="/">Нүүр хуудас</a>
          <a class="btn btn-ghost magnetic" href="/contact">Холбоо барих</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
