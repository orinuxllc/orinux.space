---
interface Props {
  eyebrow?: string; eyebrowEn?: string;
  title: string; titleEn?: string;
  sub?: string; subEn?: string;
}
const { eyebrow, eyebrowEn, title, titleEn, sub, subEn } = Astro.props;
---
<header class="page-head" data-screen-label="Page header">
  <div class="wrap">
    <div class="section-head reveal in">
      {eyebrow && <span class="eyebrow"><span class="dot"></span><span data-bi data-mn={eyebrow} data-en={eyebrowEn || eyebrow}>{eyebrow}</span></span>}
      <h1 data-bi data-mn={title} data-en={titleEn || title} set:html={title}></h1>
      {sub && <p data-bi data-mn={sub} data-en={subEn || sub}>{sub}</p>}
    </div>
  </div>
</header>

<style is:global>
  .page-head { padding: 150px 0 30px; position: relative; }
  .page-head h1 { font-family: var(--display, "Unbounded", sans-serif); font-size: clamp(34px, 6vw, 60px); line-height: 1.04; letter-spacing: -0.02em; margin: 14px 0 0; }
  .page-head p { margin-top: 16px; max-width: 640px; color: var(--text-dim, #aeb6c6); font-size: clamp(15px, 1.6vw, 18px); }
</style>
