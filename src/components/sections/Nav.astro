---
import { mn, firstLocaleValue, type Content } from "@/lib/content";
interface Props { content: Content; preview?: boolean }
const { content, preview = false } = Astro.props;
const t = (k: string) => mn(k, content);
const locales = content.locales && content.locales.length > 0 ? content.locales : ["mn", "en"];
// Admin-editable (managed-sites schema editor's "Navigation" section) — an
// ordered list of {label (localized), href} the admin can add/remove/
// reorder. Legacy hardcoded links as a fallback for a content.json that
// predates this (or any other site type without a nav section yet).
const navItems = content.nav && content.nav.length > 0 ? content.nav : [
  { label: { mn: "Платформ", en: "Platform" }, href: "/#platform" },
  { label: { mn: "Модулиуд", en: "Modules" }, href: "/modules" },
  { label: { mn: "Үнэ", en: "Pricing" }, href: "/#pricing" },
  { label: { mn: "Салбарууд", en: "Industries" }, href: "/#industries" },
  { label: { mn: "Баг", en: "Team" }, href: "/#team" },
  { label: { mn: "Мэдээ", en: "News" }, href: "/news" },
  { label: { mn: "Асуулт", en: "FAQ" }, href: "/#faq" },
];
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a class="logo" href="/#top"><span class="mark">O</span>orinux</a>
    <div class="nav-links">
      {navItems.map((item) => (
        // No data-field-path: nav is a TopLevel LIST field (field_path is
        // the bare "nav" key for the whole array, not one per item/index),
        // the same shape class as pricing/faq/team — list content has no
        // live-preview-sync hook yet (see preview-sync.js's own doc
        // comment), only a Save updates it. data-bi + data-i18n-json still
        // give it the right initial render + correct language on toggle.
        <a href={item.href} data-bi data-i18n-json={JSON.stringify(item.label)}>
          {firstLocaleValue(item.label, content)}
        </a>
      ))}
    </div>
    <div class="nav-actions">
      <div class="nav-util">
        <div class="lang-toggle" role="group" aria-label="Language">
          {locales.map((code, i) => (
            <button data-lang={code} aria-pressed={i === 0 ? "true" : "false"}>{code.toUpperCase()}</button>
          ))}
        </div>
        <button class="icon-btn theme-btn" aria-label="Theme" title="Theme">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"/></svg>
        </button>
      </div>
      <a class="btn btn-primary nav-cta" href="/#demo" data-i18n="nav_cta" set:html={t("nav_cta")}></a>
      <button class="menu-btn" aria-label="Цэс">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</nav>
