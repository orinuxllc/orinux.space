---
import { mn, type Content } from "@/lib/content";
interface Props { content: Content; preview?: boolean }
const { content, preview = false } = Astro.props;
const t = (k: string) => mn(k, content);
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a class="logo" href="/#top"><span class="mark">O</span>orinux</a>
    <div class="nav-links">
      <a href="/#platform" data-i18n="nav_platform" set:html={t("nav_platform")}></a>
      <a href="/modules" data-i18n="nav_modules" set:html={t("nav_modules")}></a>
      <a href="/#pricing" data-i18n="nav_pricing" set:html={t("nav_pricing")}></a>
      <a href="/#industries" data-i18n="nav_industries" set:html={t("nav_industries")}></a>
      <a href="/#faq" data-i18n="nav_faq" set:html={t("nav_faq")}></a>
    </div>
    <div class="nav-actions">
      <div class="nav-util">
        <div class="lang-toggle" role="group" aria-label="Language">
          <button data-lang="mn" aria-pressed="true">МН</button>
          <button data-lang="en" aria-pressed="false">EN</button>
        </div>
        <button class="icon-btn theme-btn" aria-label="Theme" title="Theme">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"/></svg>
        </button>
      </div>
      {!preview && <a class="login" href="/admin" data-i18n="nav_login" set:html={t("nav_login")}></a>}
      <a class="btn btn-primary nav-cta" href="/#demo" data-i18n="nav_cta" set:html={t("nav_cta")}></a>
      <button class="menu-btn" aria-label="Цэс">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</nav>
