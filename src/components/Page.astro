---
import { news as staticNews, type Content, type News } from "@/lib/content";
import Hero from "@/components/sections/Hero.astro";
import Trust from "@/components/sections/Trust.astro";
import Platform from "@/components/sections/Platform.astro";
import Results from "@/components/sections/Results.astro";
import Comparison from "@/components/sections/Comparison.astro";
import Features from "@/components/sections/Features.astro";
import Modules from "@/components/sections/Modules.astro";
import Pricing from "@/components/sections/Pricing.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import Services from "@/components/sections/Services.astro";
import IndustryStage from "@/components/sections/IndustryStage.astro";
import Industries from "@/components/sections/Industries.astro";
import Demo from "@/components/sections/Demo.astro";
import Faq from "@/components/sections/Faq.astro";
import News from "@/components/sections/News.astro";
import Team from "@/components/sections/Team.astro";
import FinalCta from "@/components/sections/FinalCta.astro";

interface Props { content: Content; news?: News }
const { content, news = staticNews } = Astro.props;
---
<div data-field-section="heroStats"><Hero content={content} /></div>
<div data-field-section="trust"><Trust content={content} /></div>
<Platform content={content} />
<div data-field-section="quote"><Results content={content} /></div>
<Comparison content={content} />
<div data-field-section="features"><Features content={content} /></div>
<div data-field-section="modules"><Modules content={content} /></div>
<div data-field-section="pricing"><Pricing content={content} /></div>
<HowItWorks content={content} />
<div data-field-section="services"><Services content={content} /></div>
<IndustryStage content={content} />
<div data-field-section="industries"><Industries content={content} /></div>
<Demo content={content} />
<div data-field-section="faq"><Faq content={content} /></div>
<div data-field-section="teams"><Team content={content} /></div>
<News content={content} news={news} limit={3} />
<FinalCta content={content} />
