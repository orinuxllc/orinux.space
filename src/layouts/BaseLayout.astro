---
import Nav from "@/components/sections/Nav.astro";
import Footer from "@/components/sections/Footer.astro";
import { content as staticContent, type Content } from "@/lib/content";

interface Props {
  title?: string;
  description?: string;
  /** Live content (defaults to the committed JSON; preview passes the draft). */
  content?: Content;
  /** Hide admin-only chrome when rendered inside the admin preview iframe. */
  preview?: boolean;
}

const {
  content = staticContent,
  preview = false,
  title = content.meta.title,
  description = content.meta.description,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.pathname;
const ogImage = content.meta.ogImage;
const favicon = content.meta.favicon || "/favicon.svg";
const faviconType = favicon.endsWith(".svg") ? "image/svg+xml" : undefined;
---

<!doctype html>
<html lang="mn" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Orinux LLC" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={favicon} type={faviconType} />

    <!-- Fonts (design system) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Unbounded:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/pro.css" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#060709" />

    <!-- Avoid theme flash before interactions.js runs -->
    <script is:inline>
      try {
        document.documentElement.setAttribute(
          "data-theme",
          localStorage.getItem("orinux-theme") || "dark",
        );
      } catch (e) {}
    </script>

    <!-- CMS content → client globals (i18n dictionary + trust logos + site languages) -->
    <script is:inline define:vars={{ dict: content.i18n, trust: content.trust, preview, locales: content.locales }}>
      window.__ORINUX_I18N__ = dict;
      window.__ORINUX_TRUST__ = trust;
      window.__ORINUX_PREVIEW__ = preview;
      window.__ORINUX_LOCALES__ = locales;
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Orinux ARP",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description: content.meta.description,
      offers: { "@type": "Offer", price: "199000", priceCurrency: "MNT" },
      publisher: { "@type": "Organization", name: "Orinux LLC", email: content.contact.email },
    })} />

    <slot name="head" />
  </head>
  <body class:list={[{ "is-preview": preview }]}>
    <div class="cursor-glow" id="cursor-glow"></div>
    <div class="backdrop"></div>
    <div class="grain"></div>

    <Nav content={content} preview={preview} />
    <slot />
    <Footer content={content} />

    <!-- Ported design scripts (plain IIFEs in /public/assets) -->
    <script is:inline src="/assets/app.js"></script>
    <script is:inline src="/assets/opsScene.js"></script>
    <script is:inline src="/assets/dashboard.js"></script>
    <script is:inline src="/assets/interactions.js"></script>
    <script is:inline src="/assets/i18n.js"></script>
  </body>
</html>
