# ── Orinux CMS environment ──────────────────────────────────────────────
# Copy to `.env` for local dev (gitignored). On Vercel, set these in
# Project → Settings → Environment Variables. NEVER commit real values.

# Google OAuth (Sign-In). Create an OAuth 2.0 Client ID (Web) in Google Cloud
# Console; add your domain + http://localhost:4321 to authorized origins.
# Both must hold the SAME client id (PUBLIC_ is exposed to the browser button;
# the bare one is used server-side to verify the ID token).
PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Owner emails (comma-separated). Always allowed, can't be removed in the UI.
ADMIN_EMAILS=you@example.com

# GitHub repo the CMS commits to, and a fine-grained PAT with
# "Contents: Read and write" on that repo.
GITHUB_REPO=orinuxllc/orinux.space
GITHUB_TOKEN=github_pat_xxx
GITHUB_BRANCH=main
GITHUB_DRAFT_BRANCH=cms-draft
GITHUB_FORM_BRANCH=form

# Demo-form email notifications (optional — Resend). If unset, submissions are
# still stored on the `form` branch and visible in the admin.
RESEND_API_KEY=
DEMO_NOTIFY=you@example.com
DEMO_FROM=Orinux Demo <onboarding@resend.dev>
